    {
      "name": "b2b78eb4",
      "displayName": "product_performance",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.product_performance",
        "dimensions": [
          {
            "name": "product",
            "expr": "product",
            "displayName": "Producto"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "name": "revenue",
            "expr": "SUM(revenue)",
            "displayName": "Ingresos",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "revenue_share_pct",
            "expr": "SUM(revenue_share_pct)",
            "displayName": "% Participación de Ingresos",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "n_transactions",
            "expr": "SUM(n_transactions)",
            "displayName": "Transacciones"
          },
          {
            "name": "units_sold",
            "expr": "SUM(units_sold)",
            "displayName": "Unidades Vendidas"
          }
        ]
      }
    },
    {
      "name": "top_franchises",
      "displayName": "Top 10 Franquicias por Ingresos",
      "config": {
        "version": "1.1",
        "source": "SELECT franchise_name, SUM(revenue) AS revenue\nFROM workspace.gold.daily_sales_by_franchise\nGROUP BY franchise_name\nORDER BY revenue DESC\nLIMIT 10\n",
        "dimensions": [
          {
            "name": "franchise_name",
            "expr": "franchise_name",
            "displayName": "Franquicia"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(revenue)",
            "displayName": "Ingresos",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "top_customers",
      "displayName": "Top 20 Clientes por Gasto",
      "config": {
        "version": "1.1",
        "source": "SELECT customer_id, current_city, n_transactions, total_spent, avg_ticket\nFROM workspace.gold.customer_metrics\nORDER BY total_spent DESC\nLIMIT 20\n",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id",
            "displayName": "ID de Cliente"
          },
          {
            "name": "current_city",
            "expr": "current_city",
            "displayName": "Ciudad"
          }
        ],
        "measures": [
          {
            "name": "total_spent",
            "expr": "SUM(total_spent)",
            "displayName": "Gasto Total",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "n_transactions",
            "expr": "SUM(n_transactions)",
            "displayName": "Transacciones"
          },
          {
            "name": "avg_ticket",
            "expr": "SUM(avg_ticket)",
            "displayName": "Ticket Promedio",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
