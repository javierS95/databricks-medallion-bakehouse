{
  "datasets": [
    {
      "name": "26493ca7",
      "displayName": "customer_metrics",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.customer_metrics",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id",
            "displayName": "ID de Cliente"
          },
          {
            "name": "current_city",
            "expr": "current_city",
            "displayName": "Ciudad"
          },
          {
            "name": "first_purchase",
            "expr": "first_purchase",
            "displayName": "Primera Compra"
          },
          {
            "name": "last_purchase",
            "expr": "last_purchase",
            "displayName": "Última Compra"
          }
        ],
        "measures": [
          {
            "name": "total_spent",
            "expr": "SUM(total_spent)",
            "displayName": "Gasto Total",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "n_transactions",
            "expr": "SUM(n_transactions)",
            "displayName": "Número de Transacciones"
          },
          {
            "name": "avg_ticket",
            "expr": "SUM(total_spent) / SUM(n_transactions)",
            "displayName": "Ticket Promedio",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "e6c9b016",
      "displayName": "daily_sales_by_franchise",
